# =============================================================
# Scale Customer Intelligence — variáveis de ambiente (exemplo)
# Copie para .env (local) ou infrastructure/compose/env/<ambiente>.env
# NUNCA versione o arquivo com valores reais.
# =============================================================

# --- Ambiente
SCI_ENV=development            # development | staging | production
SCI_VERSION=0.1.0
LOG_LEVEL=info

# --- Banco (PostgreSQL 16)
SCI_DB_NAME=sci_dev
POSTGRES_SUPERUSER_PASSWORD=
SCI_DB_OWNER_PASSWORD=         # papel sci_owner: só migrations
SCI_DB_APP_PASSWORD=           # papel sci_app: aplicação (sujeito a RLS)
DATABASE_URL=postgres://sci_app:sci_app_dev@localhost:5432/sci_dev
DATABASE_OWNER_URL=postgres://sci_owner:sci_owner_dev@localhost:5432/sci_dev

# --- Redis (filas)
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- API
PORT=4000
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
COOKIE_SECURE=false            # true obrigatório em staging/produção
COOKIE_DOMAIN=
SESSION_TTL_HOURS=168

# --- Web
NEXT_PUBLIC_API_URL=http://localhost:4000
# IDs autorizados da extensão Scale Assistant (separados por vírgula)
NEXT_PUBLIC_EXTENSION_IDS=

# --- Domínios (staging/produção)
APP_DOMAIN=
API_DOMAIN=

# --- Criptografia de credenciais (tokens de CRM etc.)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCI_ENCRYPTION_KEYS=k1:
SCI_ENCRYPTION_ACTIVE_KEY=k1

# --- Provedores de IA (Etapas 2–4). Ficam SOMENTE no backend.
# Ficam no WORKER (Compose já faz isso). Confirme os IDs de modelo na documentação oficial.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=
DEEPSEEK_MODEL_REASONING=
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=
# Deepgram fica na API (relay do áudio)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pt-BR
