{
  "name": "@sci/playbooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extração de texto de documentos de playbook (PDF, DOCX, PPTX, XLSX, TXT, Markdown).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@sci/contracts": "workspace:*",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "unpdf": "2.1.0"
  }
}
